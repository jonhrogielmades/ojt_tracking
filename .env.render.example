APP_NAME="OJT Tracker"
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_PHP_ARTISAN_KEY_GENERATE_SHOW
APP_DEBUG=false
APP_URL=https://ojt-tracking-rogiel.onrender.com
ASSET_URL=https://ojt-tracking-rogiel.onrender.com
APP_FORCE_HTTPS=true
TRUSTED_PROXIES=*
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_URL=REPLACE_WITH_RENDER_INTERNAL_DATABASE_URL
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local
DOCUMENTS_DISK=local
ATTACHMENTS_DISK=local
DATABASE_BACKUP_ENABLED=false

# Optional persistent private-file storage (Amazon S3, Cloudflare R2, or compatible service):
# DOCUMENTS_DISK=s3
# ATTACHMENTS_DISK=s3
# AWS_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=REPLACE_WITH_BUCKET
# AWS_ENDPOINT=https://REPLACE_WITH_S3_ENDPOINT
# AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=2525
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS=REPLACE_WITH_VERIFIED_SENDER_EMAIL
MAIL_FROM_NAME="OJT Tracker"

INITIAL_ADMIN_NAME="OJT Administrator"
INITIAL_ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

RENDER_CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
